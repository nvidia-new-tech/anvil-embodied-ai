<?xml version="1.0" encoding="UTF-8" ?>
<!-- CycloneDDS config for single-PC deployment (host network mode).
     Both inference container and workcell run on the same machine, so traffic is
     pinned to loopback. autodetermine picks the first UP non-loopback interface,
     which on a box with no wired link is WiFi; camera samples are fragmented, the
     WiFi tx queue then drops fragments (sendmsg -> ENOBUFS) and the subscriber
     reassembles truncated JPEGs. Loopback has a 64K MTU and does not drop.
     Discovery is unicast via the 127.0.0.1 peer below, so multicast is off. -->
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <Interfaces>
                <NetworkInterface name="lo"/>
            </Interfaces>
            <AllowMulticast>false</AllowMulticast>
            <FragmentSize>4000B</FragmentSize>
        </General>
        <Discovery>
            <Peers>
                <Peer address="127.0.0.1"/>
            </Peers>
            <ParticipantIndex>auto</ParticipantIndex>
        </Discovery>
        <Internal>
            <SocketReceiveBufferSize min="128MB"/>
            <Watermarks>
                <WhcHigh>8MB</WhcHigh>
            </Watermarks>
        </Internal>
    </Domain>
</CycloneDDS>
